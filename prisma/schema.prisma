generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FLEET_MANAGER
  DRIVER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  IN_MAINTENANCE
  IN_USE
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      UserRole   @default(FLEET_MANAGER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  // Relacionamentos operacionais (um Gestor é dono de veículos e motoristas)
  vehicles Vehicle[] @relation("VehicleOwner")
  drivers  Driver[]  @relation("DriverOwner")
  maintenances Maintenance[] @relation("MaintenanceOwner")
  fuelRecords FuelRecord[] @relation("FuelRecordOwner")
  driverSuspensions DriverSuspension[] @relation("DriverSuspensionOwner")

  // Relacionamento 1:1 opcional (caso um usuário do tipo DRIVER esteja vinculado a um motorista da frota)
  driverProfile Driver? @relation("DriverUserAccount")

  @@map("users")
}

model Vehicle {
  id              String        @id @default(uuid())
  plate           String        @unique
  brand           String?
  model           String
  year            Int
  currentKm       Int           @map("current_km")
  crlvExpiration  DateTime?     @map("crlv_expiration")
  status          VehicleStatus @default(AVAILABLE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")


  // Vínculo com o Gestor responsável (Proprietário dos dados)
  ownerId String @map("owner_id")
  owner   User   @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  trips Trip[]
  maintenances Maintenance[]
  fuelRecords FuelRecord[]

  @@map("vehicles")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Driver {
  id                String       @id @default(uuid())
  name              String
  cpf               String       @unique
  cnhNumber         String       @unique @map("cnh_number")
  cnhCategory       String       @map("cnh_category")
  cnhExpirationDate DateTime     @map("cnh_expiration_date")
  status            DriverStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Vínculo com o Gestor responsável (Proprietário dos dados)
  ownerId String @map("owner_id")
  owner   User   @relation("DriverOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Vínculo OPCIONAL com a conta de usuário (Acesso ao app por um motorista)
  userId String? @unique @map("user_id")
  user   User?   @relation("DriverUserAccount", fields: [userId], references: [id], onDelete: SetNull)

  trips Trip[]
  fuelRecords FuelRecord[]
  suspensions DriverSuspension[]

  @@map("drivers")
}

enum SuspensionReasonCategory {
  CNH_VENCIDA
  ACIDENTE
  PROCESSO_DISCIPLINAR
  EXAME_TOXICOLOGICO_PENDENTE
  DOCUMENTACAO_IRREGULAR
  OUTRO
}

enum SuspensionStatus {
  ATIVA
  ENCERRADA
}

model DriverSuspension {
  id                 String                   @id @default(uuid())
  driverId           String                   @map("driver_id")
  ownerId            String                   @map("owner_id")
  reasonCategory     SuspensionReasonCategory @map("reason_category")
  reasonDetails      String?                  @map("reason_details")
  suspendedBy        String                   @map("suspended_by")
  suspendedAt        DateTime                 @default(now()) @map("suspended_at")
  expectedReturnDate DateTime?                @map("expected_return_date")
  indefinite         Boolean                  @default(false)
  attachmentUrl      String?                  @map("attachment_url")
  liftedAt           DateTime?                @map("lifted_at")
  liftedBy           String?                  @map("lifted_by")
  liftReason         String?                  @map("lift_reason")
  status             SuspensionStatus         @default(ATIVA)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  owner  User   @relation("DriverSuspensionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
  @@index([ownerId, status])
  @@map("driver_suspensions")
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Trip {
  id                   String     @id @default(uuid())
  driverId             String     @map("driver_id")
  vehicleId            String     @map("vehicle_id")
  originAddress        String     @map("origin_address")
  originCity           String     @map("origin_city")
  originState          String     @map("origin_state")
  originLatitude       Float?     @map("origin_latitude")
  originLongitude      Float?     @map("origin_longitude")
  destinationAddress   String     @map("destination_address")
  destinationCity      String     @map("destination_city")
  destinationState     String     @map("destination_state")
  destinationLatitude  Float?     @map("destination_latitude")
  destinationLongitude Float?     @map("destination_longitude")
  status               TripStatus @default(PLANNED)
  startedAt            DateTime?  @map("started_at")
  completedAt          DateTime?  @map("completed_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  driver  Driver  @relation(fields: [driverId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, status])
  @@index([driverId, status])
  @@map("trips")
}

enum MaintenanceType {
  PREVENTIVA
  CORRETIVA
}

enum MaintenanceStatus {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Maintenance {
  id                String            @id @default(uuid())
  vehicleId         String            @map("vehicle_id")
  ownerId           String            @map("owner_id")
  type              MaintenanceType   @default(PREVENTIVA)
  status            MaintenanceStatus @default(AGENDADA)
  description       String
  serviceProvider   String?           @map("service_provider")
  scheduledDate     DateTime?         @map("scheduled_date")
  startedAt         DateTime?         @map("started_at")
  finishedAt        DateTime?         @map("finished_at")
  odometerAtService Int?              @map("odometer_at_service")
  cost              Float             @default(0)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  vehicle Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  owner   User              @relation("MaintenanceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items   MaintenanceItem[]

  @@index([vehicleId, status])
  @@index([ownerId, status])
  @@map("maintenances")
}

model MaintenanceItem {
  id            String   @id @default(uuid())
  maintenanceId String   @map("maintenance_id")
  name          String
  cost          Float
  quantity      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@map("maintenance_items")
}

enum FuelType {
  GASOLINA
  ETANOL
  DIESEL
  DIESEL_S10
  GNV
  ELETRICO
}

model FuelRecord {
  id                String   @id @default(uuid())
  vehicleId         String   @map("vehicle_id")
  driverId          String   @map("driver_id")
  ownerId           String   @map("owner_id")
  fuelType          FuelType @default(GASOLINA) @map("fuel_type")
  liters            Float
  pricePerUnit      Float    @map("price_per_unit")
  totalCost         Float    @map("total_cost")
  odometerAtFueling Int      @map("odometer_at_fueling")
  gasStation        String?  @map("gas_station")
  fullTank          Boolean  @default(true) @map("full_tank")
  receiptUrl        String?  @map("receipt_url")
  fueledAt          DateTime @default(now()) @map("fueled_at")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  owner   User    @relation("FuelRecordOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([vehicleId, fueledAt])
  @@index([driverId, fueledAt])
  @@map("fuel_records")
}

