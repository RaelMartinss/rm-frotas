generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  FLEET_MANAGER
  ADMIN
  DRIVER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ClientStatus {
  ATIVO
  SUSPENSO
  CANCELADO
}

enum VehicleStatus {
  AVAILABLE
  IN_MAINTENANCE
  IN_USE
}

model Client {
  id           String       @id @default(uuid())
  legalName    String       @map("legal_name")
  tradeName    String       @map("trade_name")
  document     String       @unique
  billingEmail String       @map("billing_email")
  status       ClientStatus @default(ATIVO)

  // Endereço
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?      @map("zip_code")

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users             User[]
  vehicles          Vehicle[]
  drivers           Driver[]
  trips             Trip[]
  maintenances      Maintenance[]
  fuelRecords       FuelRecord[]
  driverSuspensions DriverSuspension[]
  incidents         Incident[]

  @@map("clients")
}

model User {
  id                     String     @id @default(uuid())
  name                   String
  email                  String     @unique
  password               String
  role                   UserRole   @default(FLEET_MANAGER)
  status                 UserStatus @default(ACTIVE)
  mustChangePassword     Boolean    @default(false) @map("must_change_password")
  temporaryPasswordSetAt DateTime?  @map("temporary_password_set_at")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  // Push Notification FCM Token
  pushToken              String?    @map("push_token")

  // Vínculo com a Organização/Empresa Cliente (nulo apenas para SUPER_ADMIN)
  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Relacionamentos operacionais auditáveis (quem criou/gerenciou)
  vehicles          Vehicle[]          @relation("VehicleOwner")
  drivers           Driver[]           @relation("DriverOwner")
  maintenances      Maintenance[]      @relation("MaintenanceOwner")
  fuelRecords       FuelRecord[]       @relation("FuelRecordOwner")
  driverSuspensions DriverSuspension[] @relation("DriverSuspensionOwner")

  // Relacionamento 1:1 opcional (caso um usuário do tipo DRIVER esteja vinculado a um motorista da frota)
  driverProfile Driver? @relation("DriverUserAccount")

  @@index([clientId])
  @@map("users")
}

model Vehicle {
  id             String        @id @default(uuid())
  plate          String        @unique
  brand          String?
  model          String
  year           Int
  currentKm      Int           @map("current_km")
  crlvExpiration DateTime?     @map("crlv_expiration")
  status         VehicleStatus @default(AVAILABLE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Vínculo Multi-Tenant por Cliente
  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Auditoria de quem cadastrou
  ownerId String @map("owner_id")
  owner   User   @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  trips        Trip[]
  maintenances Maintenance[]
  fuelRecords  FuelRecord[]
  incidents    Incident[]

  @@index([clientId])
  @@index([clientId, status])
  @@map("vehicles")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Driver {
  id                String       @id @default(uuid())
  name              String
  cpf               String       @unique
  cnhNumber         String       @unique @map("cnh_number")
  cnhCategory       String       @map("cnh_category")
  cnhExpirationDate DateTime     @map("cnh_expiration_date")
  status            DriverStatus @default(ACTIVE)
  pushToken         String?      @map("push_token")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Vínculo Multi-Tenant por Cliente
  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Auditoria de quem cadastrou
  ownerId String @map("owner_id")
  owner   User   @relation("DriverOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Vínculo OPCIONAL com a conta de usuário (Acesso ao app por um motorista)
  userId String? @unique @map("user_id")
  user   User?   @relation("DriverUserAccount", fields: [userId], references: [id], onDelete: SetNull)

  trips       Trip[]
  fuelRecords FuelRecord[]
  suspensions DriverSuspension[]
  incidents   Incident[]

  @@index([clientId])
  @@index([clientId, status])
  @@map("drivers")
}

enum SuspensionReasonCategory {
  CNH_VENCIDA
  ACIDENTE
  PROCESSO_DISCIPLINAR
  EXAME_TOXICOLOGICO_PENDENTE
  DOCUMENTACAO_IRREGULAR
  OUTRO
}

enum SuspensionStatus {
  ATIVA
  ENCERRADA
}

model DriverSuspension {
  id                 String                   @id @default(uuid())
  driverId           String                   @map("driver_id")
  clientId           String                   @map("client_id")
  ownerId            String                   @map("owner_id")
  reasonCategory     SuspensionReasonCategory @map("reason_category")
  reasonDetails      String?                  @map("reason_details")
  suspendedBy        String                   @map("suspended_by")
  suspendedAt        DateTime                 @default(now()) @map("suspended_at")
  expectedReturnDate DateTime?                @map("expected_return_date")
  indefinite         Boolean                  @default(false)
  attachmentUrl      String?                  @map("attachment_url")
  liftedAt           DateTime?                @map("lifted_at")
  liftedBy           String?                  @map("lifted_by")
  liftReason         String?                  @map("lift_reason")
  status             SuspensionStatus         @default(ATIVA)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner  User   @relation("DriverSuspensionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
  @@index([clientId, status])
  @@index([ownerId, status])
  @@map("driver_suspensions")
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Trip {
  id                   String     @id @default(uuid())
  driverId             String     @map("driver_id")
  vehicleId            String     @map("vehicle_id")
  clientId             String     @map("client_id")
  originAddress        String     @map("origin_address")
  originCity           String     @map("origin_city")
  originState          String     @map("origin_state")
  originLatitude       Float?     @map("origin_latitude")
  originLongitude      Float?     @map("origin_longitude")
  destinationAddress   String     @map("destination_address")
  destinationCity      String     @map("destination_city")
  destinationState     String     @map("destination_state")
  destinationLatitude  Float?     @map("destination_latitude")
  destinationLongitude Float?     @map("destination_longitude")
  status               TripStatus @default(PLANNED)
  scheduledDate        DateTime?  @map("scheduled_date")
  startedAt            DateTime?  @map("started_at")
  completedAt          DateTime?  @map("completed_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  driver  Driver  @relation(fields: [driverId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  locationPings TripLocationPing[]
  incidents     Incident[]

  @@index([clientId, status])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@map("trips")
}

model TripLocationPing {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  latitude   Float
  longitude  Float
  recordedAt DateTime @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@map("trip_location_pings")
}

enum MaintenanceType {
  PREVENTIVA
  CORRETIVA
}

enum MaintenanceStatus {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Maintenance {
  id                String            @id @default(uuid())
  vehicleId         String            @map("vehicle_id")
  clientId          String            @map("client_id")
  ownerId           String            @map("owner_id")
  type              MaintenanceType   @default(PREVENTIVA)
  status            MaintenanceStatus @default(AGENDADA)
  description       String
  serviceProvider   String?           @map("service_provider")
  scheduledDate     DateTime?         @map("scheduled_date")
  startedAt         DateTime?         @map("started_at")
  finishedAt        DateTime?         @map("finished_at")
  odometerAtService Int?              @map("odometer_at_service")
  cost              Float             @default(0)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  vehicle Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  client  Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner   User              @relation("MaintenanceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items   MaintenanceItem[]

  @@index([clientId, status])
  @@index([vehicleId, status])
  @@index([ownerId, status])
  @@map("maintenances")
}

model MaintenanceItem {
  id            String   @id @default(uuid())
  maintenanceId String   @map("maintenance_id")
  name          String
  cost          Float
  quantity      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@map("maintenance_items")
}

enum FuelType {
  GASOLINA
  ETANOL
  DIESEL
  DIESEL_S10
  GNV
  ELETRICO
}

model FuelRecord {
  id                String   @id @default(uuid())
  vehicleId         String   @map("vehicle_id")
  driverId          String   @map("driver_id")
  clientId          String   @map("client_id")
  ownerId           String   @map("owner_id")
  fuelType          FuelType @default(GASOLINA) @map("fuel_type")
  liters            Float
  pricePerUnit      Float    @map("price_per_unit")
  totalCost         Float    @map("total_cost")
  odometerAtFueling Int      @map("odometer_at_fueling")
  gasStation        String?  @map("gas_station")
  fullTank          Boolean  @default(true) @map("full_tank")
  receiptUrl        String?  @map("receipt_url")
  fueledAt          DateTime @default(now()) @map("fueled_at")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner   User    @relation("FuelRecordOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([ownerId, createdAt])
  @@index([vehicleId, fueledAt])
  @@index([driverId, fueledAt])
  @@map("fuel_records")
}

enum IncidentCategory {
  PNEU
  MECANICA
  ELETRICA
  ACIDENTE
  ATRASO
  OUTRO
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Incident {
  id          String           @id @default(uuid())
  driverId    String?          @map("driver_id")
  vehicleId   String?          @map("vehicle_id")
  tripId      String?          @map("trip_id")
  clientId    String           @map("client_id")
  category    IncidentCategory @default(OUTRO)
  description String
  status      IncidentStatus   @default(OPEN)
  resolvedAt  DateTime?        @map("resolved_at")
  resolvedBy  String?          @map("resolved_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trip    Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([tripId, status])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@map("incidents")
}


